# Kernel options for the GOB v3 browser VM.
# Merged on top of the qemu-wasm x86_64 example config (no modules,
# virtio, ext4, 9p, devtmpfs). Every line here is checked after the merge:
# build-kernel.sh fails if one of them does not stick.

# IOAM, GOB and SRv6, as used by the 5-node demo
CONFIG_IPV6=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_IPV6_SEG6_LWTUNNEL=y
CONFIG_IPV6_SEG6_BPF=y
CONFIG_IPV6_IOAM6_LWTUNNEL=y
CONFIG_IPV6_IOAM6_GOB=y
CONFIG_LWTUNNEL=y
CONFIG_LWTUNNEL_BPF=y

# Network namespaces and virtual links
CONFIG_NET_NS=y
CONFIG_VETH=y
CONFIG_DUMMY=y

# eBPF, tc and tracing
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_INGRESS=y
CONFIG_NET_CLS_ACT=y
CONFIG_NET_CLS_BPF=y
CONFIG_NET_ACT_BPF=y
CONFIG_KALLSYMS=y
CONFIG_KPROBES=y
CONFIG_BPF_EVENTS=y
CONFIG_FTRACE=y

# BTF, for vmlinux.h and CO-RE
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# Keep it small and simple. The VM has one CPU: ACPI is only needed to
# bring up more than one, and it costs boot time under emulation.
CONFIG_MODULES=n
CONFIG_RANDOMIZE_BASE=n
CONFIG_ACPI=n

# Performance under emulation. Every guest instruction is emulated in
# the browser, so anything the kernel adds to each syscall, function or
# timer tick is paid many times. The VM runs alone in a browser tab, so
# the CPU vulnerability mitigations protect nothing there.
CONFIG_CPU_MITIGATIONS=n
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
CONFIG_NO_HZ_IDLE=y
CONFIG_PREEMPT_DYNAMIC=n
CONFIG_DEBUG_PREEMPT=n
CONFIG_SLUB_DEBUG=n
CONFIG_STACKPROTECTOR=n

# The demo uses no SIT tunnel, and SIT adds a sit0 device to every
# network namespace.
CONFIG_IPV6_SIT=n
