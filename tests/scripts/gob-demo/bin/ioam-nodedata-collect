#!/usr/bin/env bash
# ioam-nodedata-collect [node] [outfile] [trigger]
#
# Collect ONLY the traditional IOAM node-data (not the GOB). Stream
# `ip ioam monitor` in <node>'s netns, decode the node-data (trace type
# Hop_Lim + node_id, 4 bytes per hop) and keep <outfile> updated with the
# latest decoded table. If <trigger> is given (the FIFO of gob-dash-update),
# tell the dashboard at each packet, so the RECEIVED pane follows a ping
# live. The GOB itself is collected separately by the eBPF program into the
# gob_recv map (gob-recv-show).
#
# Bash only: starting Python costs seconds in the browser VM. ip prints
# with stdio, which is fully buffered on a pipe: stdbuf -oL makes it line
# buffered, so each event arrives when it happens. nsenter execs ip in the
# same process (ip netns exec would fork it), so killing MON_PID stops it.
node="${1:-n5}"
outfile="${2:-/tmp/ioam-nodedata.txt}"
trigger="${3:-}"
IP="/mnt/iproute2/ip/ip"

coproc MON { exec nsenter --net="/var/run/netns/${node}" stdbuf -oL "$IP" ioam monitor; }
trap 'kill "$MON_PID" 2>/dev/null; exit 0' TERM INT HUP

prev=
while IFS= read -r -u "${MON[0]}" l; do
    # the same trace as the packet before: only tell the dashboard
    if [[ $l == "$prev" ]]; then
        if [ -n "$trigger" ]; then
            printf 'recv\0' 1<>"$trigger"
        fi
        continue
    fi
    prev=$l
    [[ $l =~ NodeLen=([0-9]+)\ Type=[^\ ]+\ Data=([0-9a-fA-F]*) ]] || continue
    wl=$((BASH_REMATCH[1] * 8))
    data=${BASH_REMATCH[2]}
    out="node-data received at ${node} (newest first):
  node_id | hop_lim
  --------+--------"
    rows=0
    # one node-data entry every wl hex digits: hop_lim (1 byte), node_id (3)
    if ((wl)); then
        for ((i = 0; i + 8 <= ${#data}; i += wl)); do
            printf -v row "  %7d | %7d" $((16#${data:i+2:6})) $((16#${data:i:2}))
            out+=$'\n'"$row"
            rows=$((rows + 1))
        done
    fi
    if ((rows == 0)); then
        out+=$'\n'"  (no node-data)"
    fi
    printf '%s\n' "$out" > "$outfile"
    if [ -n "$trigger" ]; then
        printf 'recv\0' 1<>"$trigger"
    fi
done
