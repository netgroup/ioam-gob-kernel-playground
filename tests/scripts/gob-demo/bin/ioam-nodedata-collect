#!/usr/bin/env python3
# ioam-nodedata-collect [node] [outfile]
#
# Collect ONLY the traditional IOAM node-data (not the GOB). Stream
# `ip ioam monitor` in <node>'s netns, decode the node-data (trace type
# Hop_Lim + node_id, 4 bytes per hop) and keep <outfile> updated with the
# latest decoded table. Run in background by the demo setup; the RECEIVED
# pane cats <outfile> under the GOB table. The GOB itself is collected
# separately by the eBPF program into the gob_recv map (gob-recv-show).
#
# A pty is used so `ip ioam monitor` (which prints with stdio) is line
# buffered and we see each event as it arrives.
import os
import re
import pty
import sys
import select

node = sys.argv[1] if len(sys.argv) > 1 else "n5"
outfile = sys.argv[2] if len(sys.argv) > 2 else "/tmp/ioam-nodedata.txt"
IP = "/mnt/iproute2/ip/ip"
cmd = ["ip", "netns", "exec", node, IP, "ioam", "monitor"]

rex = re.compile(rb"NodeLen=(\d+) Type=(\S+) Data=([0-9a-fA-F]*)")

pid, fd = pty.fork()
if pid == 0:
    os.execvp(cmd[0], cmd)
    os._exit(127)

buf = b""
while True:
    select.select([fd], [], [])
    try:
        chunk = os.read(fd, 4096)
    except OSError:
        break
    if not chunk:
        break
    buf += chunk
    while b"\n" in buf:
        line, buf = buf.split(b"\n", 1)
        m = rex.search(line)
        if not m:
            continue
        nodelen = int(m.group(1))
        raw = bytes.fromhex(m.group(3).decode())
        wl = nodelen * 4
        rows = []
        if wl:
            for i in range(0, len(raw), wl):
                w = raw[i:i + wl]
                if len(w) < 4:
                    continue
                rows.append((int.from_bytes(w[1:4], "big"), w[0]))
        out = ["node-data received at %s (newest first):" % node,
               "  node_id | hop_lim",
               "  --------+--------"]
        if rows:
            for nid, hop in rows:
                out.append("  %7d | %7d" % (nid, hop))
        else:
            out.append("  (no node-data)")
        tmp = outfile + ".tmp"
        with open(tmp, "w") as f:
            f.write("\n".join(out) + "\n")
        os.replace(tmp, outfile)
