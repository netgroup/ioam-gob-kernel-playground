#!/usr/bin/env bash
# gob-help   -- list the GOB demo commands
cat <<'HELP'
GOB demo -- available commands:

  gob-encap gob         encap at n1: only the GOB (no node-data)
  gob-encap combined    encap at n1: node-data + GOB
  gob-encap trad        encap at n1: only the traditional node-data (no GOB)
  gob-encap off         remove it (plain fallback, network works, no IOAM)
  gob-ping [count] [ttl]  h1 pings h2 (ttl = optional hop limit, e.g. 30;
                          shifts the node-data hop_lim values)
  gob-metric set nN V   set node N metric X   (e.g. gob-metric set n3 70)
  gob-metric get nN     read node N metric X
  gob-recv-show         table of what each node received (gob_recv map)
  gob-help              this help

typical demo:
  gob-encap combined ; gob-ping    -> RECEIVED panel fills
  gob-metric set n3 70 ; gob-ping  -> downstream blocks change
  gob-ping 4 30                    -> node-data hop_lim starts lower
  gob-encap trad ; gob-ping        -> reaches h2, RECEIVED panel stays empty
  gob-encap off ; gob-ping         -> still reaches h2, no IOAM at all
HELP
