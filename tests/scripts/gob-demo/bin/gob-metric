#!/usr/bin/env bash
# gob-metric set nN V | get nN   -- read/write a node metric X (gob_metric map)
BT="/mnt/shared/bpftool"
PIN="/sys/fs/bpf/tc/globals/gob_metric"
node="${2#n}"
key=$((node - 1))
case "$1" in
set)
    v="$3"
    "$BT" map update pinned "$PIN" key $key 0 0 0 \
        value $((v & 255)) $(((v >> 8) & 255)) $(((v >> 16) & 255)) $(((v >> 24) & 255))
    rc=$?
    # Inside the tmux dashboard, tell its panes to refresh now (they wait
    # for this signal instead of polling).
    if [ -n "${TMUX:-}" ]; then tmux wait-for -S gob-refresh; fi
    exit $rc
    ;;
get)
    # Plain bpftool output, read with bash only: starting Python costs
    # seconds in the browser VM. With BTF it prints "value": N; without,
    # the four value bytes, little endian.
    out=$("$BT" map lookup pinned "$PIN" key $key 0 0 0 2>/dev/null)
    if [[ $out =~ \"value\":\ ([0-9]+) ]]; then
        echo "${BASH_REMATCH[1]}"
    elif [[ $out =~ value:\ ([0-9a-f]{2})\ ([0-9a-f]{2})\ ([0-9a-f]{2})\ ([0-9a-f]{2}) ]]; then
        echo $((0x${BASH_REMATCH[1]} | 0x${BASH_REMATCH[2]} << 8 |
                0x${BASH_REMATCH[3]} << 16 | 0x${BASH_REMATCH[4]} << 24))
    else
        echo "gob-metric: cannot read $PIN key $key" >&2
        exit 1
    fi
    ;;
*)
    echo "usage: gob-metric set nN V | get nN" ;;
esac
