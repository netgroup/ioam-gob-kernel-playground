# IOAM GOB on the UML kernel that build.sh builds from the GOB tree, on top
# of base.fragment, trace.fragment and net.fragment of kathara-uml-lab: the
# IOAM Pre-allocated Trace insertion, the GOB processing path, which runs
# eBPF programs, and SRv6 behaviors, so that the last node of a GOB domain
# can take the encapsulation off with End.DT6. BTF, so that the programs
# built against vmlinux.h (CO-RE) find the types of the running kernel in
# /sys/kernel/btf/vmlinux. Only for a tree that has IPV6_IOAM6_GOB:
# mainline Linux has not.
CONFIG_BPF_SYSCALL=y
CONFIG_IPV6_IOAM6_LWTUNNEL=y
CONFIG_IPV6_IOAM6_GOB=y
CONFIG_IPV6_SEG6_LWTUNNEL=y
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
CONFIG_DEBUG_INFO_BTF=y
